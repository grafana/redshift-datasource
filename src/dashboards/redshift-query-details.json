    {
      "datasource": {
        "uid": "${ds}"
      },
      "description": "Query lifecycle: elapsed > compile/planning/lock_wait/queue/execution > child_query > stream.\nEach stream shows the dominant step names and the duration of the longest segment (parallel segments are not stacked).\nRefer to Query Details table for all segments and steps.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "value"
            },
            "properties": []
          },
          {
            "matcher": {
              "id": "byName",
              "options": "self"
            },
            "properties": []
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 14,
      "options": {
        "colorScheme": "byValue",
        "selectedView": "flamegraph"
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "datasource": {
            "uid": "${ds}"
          },
          "format": 1,
          "rawSQL": "WITH qh AS (\n  SELECT elapsed_time, compile_time, planning_time, lock_wait_time, queue_time, execution_time,\n    elapsed_time - compile_time - planning_time - lock_wait_time - queue_time - execution_time AS other_time\n  FROM sys_query_history WHERE query_id = $query_id\n),\nsteps AS (\n  SELECT child_query_sequence AS cqs, stream_id, segment_id, step_id,\n    trim(step_name) AS step_name, duration\n  FROM sys_query_detail\n  WHERE query_id = $query_id AND step_id >= 0\n),\nstream_info AS (\n  SELECT cqs, stream_id,\n    listagg(DISTINCT step_name, ', ') WITHIN GROUP (ORDER BY step_name) AS all_steps\n  FROM steps GROUP BY 1, 2\n),\ntop_seg AS (\n  SELECT cqs, stream_id, max(seg_dur) AS duration\n  FROM (SELECT cqs, stream_id, segment_id, max(duration) AS seg_dur FROM steps GROUP BY 1,2,3)\n  GROUP BY 1, 2\n),\ncqs_dur AS (\n  SELECT cqs, sum(duration) AS duration FROM top_seg GROUP BY 1\n),\nexec_dur AS (\n  SELECT sum(duration) AS duration FROM cqs_dur\n),\nall_rows AS (\n  SELECT 0 AS lvl, 'elapsed' AS label, qh.elapsed_time AS value, GREATEST(0, qh.other_time) AS self, 0 s1, 0 s2, 0 s3 FROM qh\n  UNION ALL SELECT 1, 'compile', qh.compile_time, qh.compile_time, 2, 0, 0 FROM qh\n  UNION ALL SELECT 1, 'planning', qh.planning_time, qh.planning_time, 1, 0, 0 FROM qh\n  UNION ALL SELECT 1, 'lock_wait', qh.lock_wait_time, qh.lock_wait_time, 3, 0, 0 FROM qh\n  UNION ALL SELECT 1, 'queue', qh.queue_time, qh.queue_time, 4, 0, 0 FROM qh\n  UNION ALL SELECT 1, 'execution', qh.execution_time, GREATEST(0, qh.execution_time - e.duration), 5, 0, 0 FROM qh, exec_dur e\n  UNION ALL SELECT 2, 'child_query ' || c.cqs, c.duration, 0::bigint, 5, c.cqs, 0 FROM cqs_dur c\n  UNION ALL SELECT 3, 'stream ' || t.stream_id || ': ' || s.all_steps, t.duration, t.duration, 5, t.cqs, t.stream_id FROM top_seg t JOIN stream_info s USING (cqs, stream_id)\n)\nSELECT lvl AS level, label, round(value/1000000.0, 3) AS value, round(self/1000000.0, 3) AS self FROM all_rows ORDER BY s1, s2, s3, lvl",
          "refId": "A"
        }
      ],
      "title": "Query Breakdown",
      "type": "flamegraph"
    },
