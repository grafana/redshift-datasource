          "rawSQL": "SELECT sum(input_rows) as total_rows_in, sum(output_rows) as total_rows_out,\n  sum(input_bytes) as total_bytes_in, sum(output_bytes) as total_bytes_out,\n  sum(blocks_read) as total_blocks_read, sum(blocks_write) as total_blocks_write,\n  max(data_skewness) as max_data_skewness, max(time_skewness) as max_time_skewness,\n  sum(spilled_block_local_disk) as total_spilled_local, sum(spilled_block_remote_disk) as total_spilled_remote\nFROM sys_query_detail WHERE query_id = $query_id AND $__timeFilter(start_time)",
