      "pluginVersion": "11.6.0",
      "targets": [
        {
          "datasource": {
            "uid": "${ds}"
          },
          "format": 1,
          "rawSQL": "SELECT\n  d.metrics_level,\n  d.child_query_sequence,\n  d.stream_id, d.segment_id, d.step_id,\n  d.step_name, d.table_name,\n  REPLACE(e.plan_node, ' ', chr(160)) AS plan_node, e.plan_info,\n  d.duration,\n  d.input_rows, d.output_rows,\n  CASE WHEN d.input_rows > 0 THEN round(d.output_rows::float / d.input_rows * 100, 2) END AS scan_efficiency,\n  d.input_bytes, d.output_bytes,\n  d.local_read_io, d.remote_read_io,\n  d.blocks_read, d.blocks_write,\n  d.data_skewness, d.time_skewness,\n  d.spilled_block_local_disk, d.spilled_block_remote_disk,\n  d.is_rrscan, d.table_id,\n  d.start_time, d.end_time\nFROM sys_query_detail d\nLEFT JOIN sys_query_explain e\n  ON d.query_id = e.query_id\n  AND d.child_query_sequence = e.child_query_sequence\n  AND d.plan_node_id = e.plan_node_id\n  AND d.metrics_level = 'step'\nWHERE d.query_id = $query_id\nORDER BY d.child_query_sequence, d.stream_id, d.segment_id, d.step_id",
          "refId": "A"
        }
      ],
