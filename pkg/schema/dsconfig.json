{
  "$schema": "https://raw.githubusercontent.com/grafana/dsconfig/refs/tags/dsconfig/v0.0.12/dsconfig/schema.json",
  "schemaVersion": "v1",
  "pluginType": "grafana-redshift-datasource",
  "pluginName": "Amazon Redshift",
  "docURL": "https://grafana.com/grafana/plugins/grafana-redshift-datasource/",
  "fields": [
    {
      "id": "jsonData_authType",
      "key": "authType",
      "label": "Authentication Provider",
      "description": "Specify which AWS credentials chain to use.",
      "valueType": "string",
      "target": "jsonData",
      "role": "auth.discriminator",
      "defaultValue": "default",
      "validations": [
        {
          "type": "allowedValues",
          "values": ["default", "keys", "credentials", "ec2_iam_role", "grafana_assume_role", "arn"]
        }
      ],
      "ui": {
        "component": "select",
        "options": [
          {
            "label": "Workspace IAM Role",
            "value": "ec2_iam_role"
          },
          {
            "label": "Grafana Assume Role",
            "value": "grafana_assume_role"
          },
          {
            "label": "AWS SDK Default",
            "value": "default"
          },
          {
            "label": "Access & secret key",
            "value": "keys"
          },
          {
            "label": "Credentials file",
            "value": "credentials"
          }
        ]
      }
    },
    {
      "id": "jsonData_profile",
      "key": "profile",
      "label": "Credentials Profile Name",
      "description": "Credentials profile name, as specified in ~/.aws/credentials, leave blank for default.",
      "valueType": "string",
      "target": "jsonData",
      "dependsOn": "jsonData_authType == 'credentials'",
      "ui": {
        "component": "input",
        "placeholder": "default"
      }
    },
    {
      "id": "secureJsonData_accessKey",
      "key": "accessKey",
      "label": "Access Key ID",
      "valueType": "string",
      "target": "secureJsonData",
      "role": "auth.aws.accessKeyId",
      "dependsOn": "jsonData_authType == 'keys'",
      "requiredWhen": "jsonData_authType == 'keys'",
      "ui": {
        "component": "input"
      }
    },
    {
      "id": "secureJsonData_secretKey",
      "key": "secretKey",
      "label": "Secret Access Key",
      "valueType": "string",
      "target": "secureJsonData",
      "role": "auth.aws.secretAccessKey",
      "dependsOn": "jsonData_authType == 'keys'",
      "requiredWhen": "jsonData_authType == 'keys'",
      "ui": {
        "component": "input"
      }
    },
    {
      "id": "secureJsonData_sessionToken",
      "key": "sessionToken",
      "valueType": "string",
      "target": "secureJsonData",
      "role": "auth.aws.sessionToken",
      "tags": ["backend-only"]
    },
    {
      "id": "jsonData_assumeRoleArn",
      "key": "assumeRoleArn",
      "label": "Assume Role ARN",
      "description": "Optional. Specifying the ARN of a role will ensure that the selected authentication provider is used to assume the role rather than the credentials directly.",
      "valueType": "string",
      "target": "jsonData",
      "dependsOn": "jsonData_authType != 'grafana_assume_role'",
      "validations": [
        {
          "type": "pattern",
          "pattern": "^(arn:aws[a-zA-Z-]*:iam::[0-9]{12}:role/.+)?$",
          "message": "When set, must be a valid IAM role ARN, e.g. arn:aws:iam::123456789012:role/MyRole"
        }
      ],
      "ui": {
        "component": "input",
        "placeholder": "arn:aws:iam:*"
      }
    },
    {
      "id": "jsonData_externalId",
      "key": "externalId",
      "label": "External ID",
      "description": "If you are assuming a role in another account, that has been created with an external ID, specify the external ID here.",
      "valueType": "string",
      "target": "jsonData",
      "dependsOn": "jsonData_authType != 'grafana_assume_role'",
      "ui": {
        "component": "input",
        "placeholder": "External ID"
      }
    },
    {
      "id": "jsonData_endpoint",
      "key": "endpoint",
      "label": "Endpoint",
      "description": "Optionally, specify a custom endpoint for the service",
      "valueType": "string",
      "target": "jsonData",
      "dependsOn": "jsonData_authType != 'grafana_assume_role'",
      "ui": {
        "component": "input",
        "placeholder": "https://{service}.{region}.amazonaws.com"
      }
    },
    {
      "id": "jsonData_defaultRegion",
      "key": "defaultRegion",
      "label": "Default Region",
      "description": "Specify the region, such as for US West (Oregon) use ` us-west-2 ` as the region.",
      "valueType": "string",
      "target": "jsonData",
      "ui": {
        "component": "select",
        "allowCustom": true
      }
    },
    {
      "id": "jsonData_useManagedSecret",
      "key": "useManagedSecret",
      "valueType": "boolean",
      "target": "jsonData",
      "defaultValue": false,
      "ui": {
        "component": "radio",
        "options": [
          {
            "label": "Temporary credentials",
            "value": false
          },
          {
            "label": "AWS Secrets Manager",
            "value": true
          }
        ]
      }
    },
    {
      "id": "jsonData_useServerless",
      "key": "useServerless",
      "label": "Serverless",
      "valueType": "boolean",
      "target": "jsonData",
      "defaultValue": false,
      "ui": {
        "component": "switch"
      }
    },
    {
      "id": "jsonData_clusterIdentifier",
      "key": "clusterIdentifier",
      "label": "Cluster Identifier",
      "valueType": "string",
      "target": "jsonData",
      "dependsOn": "jsonData_useServerless != true",
      "requiredWhen": "jsonData_useServerless != true",
      "ui": {
        "component": "select",
        "allowCustom": true
      }
    },
    {
      "id": "jsonData_workgroupName",
      "key": "workgroupName",
      "label": "Workgroup",
      "valueType": "string",
      "target": "jsonData",
      "dependsOn": "jsonData_useServerless == true",
      "requiredWhen": "jsonData_useServerless == true",
      "ui": {
        "component": "select"
      }
    },
    {
      "id": "jsonData_managedSecret_arn",
      "key": "arn",
      "section": "managedSecret",
      "label": "Managed Secret",
      "valueType": "string",
      "target": "jsonData",
      "dependsOn": "jsonData_useManagedSecret == true",
      "requiredWhen": "jsonData_useManagedSecret == true",
      "ui": {
        "component": "select",
        "allowCustom": true
      }
    },
    {
      "id": "jsonData_managedSecret_name",
      "key": "name",
      "section": "managedSecret",
      "valueType": "string",
      "target": "jsonData",
      "dependsOn": "jsonData_useManagedSecret == true",
      "tags": ["managed-by:jsonData_managedSecret_arn"]
    },
    {
      "id": "jsonData_dbUser",
      "key": "dbUser",
      "label": "Database User",
      "valueType": "string",
      "target": "jsonData",
      "dependsOn": "jsonData_useServerless != true || jsonData_useManagedSecret == true",
      "requiredWhen": "jsonData_useServerless != true && jsonData_useManagedSecret != true",
      "ui": {
        "component": "input"
      }
    },
    {
      "id": "jsonData_database",
      "key": "database",
      "label": "Database",
      "valueType": "string",
      "target": "jsonData",
      "required": true,
      "ui": {
        "component": "input"
      }
    },
    {
      "id": "jsonData_withEvent",
      "key": "withEvent",
      "label": "Send events to Amazon EventBridge",
      "valueType": "boolean",
      "target": "jsonData",
      "defaultValue": false,
      "ui": {
        "component": "switch"
      }
    }
  ],
  "groups": [
    {
      "id": "authentication",
      "title": "Authentication",
      "order": 1,
      "fieldRefs": [
        "jsonData_authType",
        "jsonData_profile",
        "secureJsonData_accessKey",
        "secureJsonData_secretKey",
        "secureJsonData_sessionToken"
      ]
    },
    {
      "id": "assume-role",
      "title": "Assume Role",
      "order": 2,
      "fieldRefs": ["jsonData_assumeRoleArn", "jsonData_externalId"]
    },
    {
      "id": "additional-settings",
      "title": "Additional Settings",
      "order": 3,
      "fieldRefs": ["jsonData_endpoint", "jsonData_defaultRegion"]
    },
    {
      "id": "redshift-details",
      "title": "Redshift Details",
      "order": 4,
      "fieldRefs": [
        "jsonData_useManagedSecret",
        "jsonData_useServerless",
        "jsonData_clusterIdentifier",
        "jsonData_workgroupName",
        "jsonData_managedSecret_arn",
        "jsonData_managedSecret_name",
        "jsonData_dbUser",
        "jsonData_database",
        "jsonData_withEvent"
      ]
    }
  ],
  "relationships": [
    {
      "type": "pair",
      "fields": ["secureJsonData_accessKey", "secureJsonData_secretKey"],
      "description": "AWS access key pair — supplied together when authType is 'keys'"
    },
    {
      "type": "group",
      "fields": ["jsonData_assumeRoleArn", "jsonData_externalId"],
      "description": "STS assume-role parameters — external ID is only meaningful when assumeRoleArn is set"
    },
    {
      "type": "group",
      "fields": ["jsonData_managedSecret_arn", "jsonData_managedSecret_name"],
      "description": "AWS Secrets Manager selection — the editor writes both fields from a single Select whose value is the secret ARN and whose label is the secret name"
    },
    {
      "type": "group",
      "fields": ["jsonData_useServerless", "jsonData_clusterIdentifier", "jsonData_workgroupName"],
      "description": "Redshift provisioning model — useServerless=false requires clusterIdentifier (Provisioned); useServerless=true requires workgroupName (Serverless)"
    },
    {
      "type": "group",
      "fields": ["jsonData_useManagedSecret", "jsonData_managedSecret_arn", "jsonData_dbUser"],
      "description": "Redshift credential mode — useManagedSecret=false requires dbUser (temporary IAM creds via GetClusterCredentials/GetCredentials); useManagedSecret=true requires managedSecret.arn (Secrets Manager stores both dbUser and password)"
    }
  ],
  "instructions": [
    {
      "msg": "Six authentication values are stored in jsonData.authType. The five editor-selectable ones are: 'default' (AWS SDK Default — the default credential chain), 'keys' (Access & secret key — puts accessKey/secretKey in secureJsonData), 'credentials' (Credentials file — optionally provide jsonData.profile), 'ec2_iam_role' (Workspace IAM Role — no extra credentials needed), and 'grafana_assume_role' (Grafana Assume Role — Grafana Cloud only; visible only when the awsDatasourcesTempCredentials feature toggle is on). The sixth is 'arn' (deprecated legacy value; the backend maps it to 'default').",
      "tags": ["llm", "auth"]
    }
  ]
}
