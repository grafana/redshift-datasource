{
  "name": "grafana-redshift-datasource",
  "version": "2.5.1",
  "description": "Use Amazon Redshift in Grafana",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "e2e": "playwright test",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix",
    "server": "docker compose up --build",
    "spellcheck": "cspell -c cspell.config.json \"**/*.{ts,tsx,js,go,md,mdx,yml,yaml,json,scss,css}\"",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "test:coverage": "jest --coverage",
    "test:coverage:changes": "jest --coverage --changedSince=origin/main",
    "typecheck": "tsc --noEmit",
    "levitate:is-compatible": "levitate is-compatible --path src/module.ts --target @grafana/data,@grafana/ui,@grafana/runtime",
    "sign": "sign-plugin"
  },
  "author": "Grafana Labs",
  "license": "Apache-2.0",
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@emotion/css": "11.13.5",
    "@grafana/async-query-data": "0.4.3",
    "@grafana/data": "13.2.1",
    "@grafana/plugin-ui": "0.17.4",
    "@grafana/runtime": "13.2.1",
    "@grafana/schema": "13.2.1",
    "@grafana/ui": "13.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semver": "7.8.5",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@grafana/aws-sdk": "0.12.1",
    "@grafana/eslint-config": "9.0.0",
    "@grafana/levitate": "0.17.3",
    "@grafana/plugin-e2e": "3.11.1",
    "@grafana/sign-plugin": "3.3.3",
    "@grafana/tsconfig": "2.2.0",
    "@openfeature/core": "1.12.0",
    "@openfeature/web-sdk": "1.10.0",
    "@playwright/test": "1.62.1",
    "@stylistic/eslint-plugin-ts": "4.4.1",
    "@swc/core": "1.16.1",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.25",
    "@types/node": "24.13.3",
    "@types/semver": "7.8.0",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "copy-webpack-plugin": "14.0.0",
    "cspell": "10.2.0",
    "css-loader": "7.1.5",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "61.7.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-webpack-plugin": "5.0.3",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "glob": "13.0.6",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "5.0.0",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "lefthook": "2.1.12",
    "prettier": "3.9.6",
    "react-select-event": "5.5.1",
    "replace-in-file-webpack-plugin": "1.0.6",
    "sass": "1.103.1",
    "sass-loader": "16.0.8",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.7",
    "terser-webpack-plugin": "5.6.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "webpack": "5.110.3",
    "webpack-cli": "7.2.3",
    "webpack-livereload-plugin": "3.0.2",
    "webpack-subresource-integrity": "5.1.0",
    "webpack-virtual-modules": "0.6.2"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.16.0"
  },
  "packageManager": "npm@11.19.1"
}
